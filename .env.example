# GCP Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Service Ports (Internal Docker)
REPO_SCANNER_PORT=8081
ORCHESTRATOR_PORT=8082
AI_ANALYZER_PORT=8083
RELAY_PORT=9000
FRONTEND_PORT=3000

# Pub/Sub Topics
PUBSUB_TOPIC_SCAN=scan-events
PUBSUB_TOPIC_OPERATIONS=operation-events

# BigQuery
BQ_DATASET=devsyncpro_analytics
BQ_TABLE_METRICS=system_metrics
