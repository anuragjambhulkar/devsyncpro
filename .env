# DevSyncPro Local Environment Configuration
# Copy this to .env

# --- Backend Configuration ---
PORT=8081

# --- Google Cloud (Mock Mode) ---
# Leave empty to disable Pub/Sub and AI Features locally
GOOGLE_CLOUD_PROJECT=
PUBSUB_TOPIC_SCAN=
PUBSUB_TOPIC_OPERATIONS=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Database (Hybrid Mode) ---
# Leave DB_HOST empty to use In-Memory Fallback (Recommended for Local)
# Uncomment these to connect to a real Postgres instance
# DB_HOST=localhost
# DB_USER=devsync
# DB_PASS=devsync_secret
# DB_NAME=devsyncpro

# --- WebSocket Relay ---
WS_PORT=9000
